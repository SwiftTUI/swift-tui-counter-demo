{
  "name": "web-example",
  "version": "0.15.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-terminal.mjs && node scripts/build-web.mjs",
    "build:dom": "node scripts/build-terminal.mjs && node scripts/build-web.mjs --renderer=dom",
    "build:dev": "node scripts/build-terminal.mjs --configuration debug && node scripts/build-web.mjs --dev",
    "build:terminal": "node scripts/build-terminal.mjs",
    "build:terminal:dev": "node scripts/build-terminal.mjs --configuration debug",
    "build:web": "node scripts/build-web.mjs",
    "build:web:dom": "node scripts/build-web.mjs --renderer=dom",
    "dev": "node scripts/build-terminal.mjs --configuration debug && node scripts/serve.mjs --watch",
    "dev:dom": "node scripts/build-terminal.mjs --configuration debug && node scripts/serve.mjs --watch --renderer=dom",
    "start": "node scripts/serve.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:browser": "node scripts/playwright.mjs install chromium webkit && node scripts/build-terminal.mjs && node scripts/build-web.mjs && node scripts/playwright.mjs test",
    "test:browser:built": "node scripts/playwright.mjs test"
  },
  "dependencies": {
    "@swifttui/build": "https://github.com/SwiftTUI/swift-tui-web/releases/download/0.15.1/swifttui-build-0.15.1.tgz",
    "@swifttui/web": "https://github.com/SwiftTUI/swift-tui-web/releases/download/0.15.1/swifttui-web-0.15.1.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  }
}
