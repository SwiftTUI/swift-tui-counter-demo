{
  "name": "swift-tui-counter-demo-workspace",
  "private": true,
  "version": "0.10.1",
  "license": "MIT",
  "workspaces": [
    "WebExample"
  ],
  "overrides": {
    "@swifttui/web": "https://github.com/SwiftTUI/swift-tui-web/releases/download/0.10.1/swifttui-web-0.10.1.tgz"
  },
  "scripts": {
    "check": "Scripts/check_counter_demo.sh --skip-clean",
    "check:linux": "Scripts/check_counter_demo.sh --linux-only --skip-clean",
    "check:macos": "Scripts/check_counter_demo.sh --macos-only --skip-clean",
    "check:web": "Scripts/check_counter_demo.sh --web-only --skip-clean",
    "build:webexample": "node WebExample/scripts/build-terminal.mjs && node WebExample/scripts/build-web.mjs"
  }
}
